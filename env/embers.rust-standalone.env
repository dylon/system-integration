# Embers backend environment for the rust-standalone docker stack.
#
# Mirrors the natively verified configuration of embers-local-stack (stack.sh
# cmd_embers / cmd_serve_drive), with two systematic substitutions:
#   - every node URL points at the standalone node container's DNS name
#     (rnode.rust-standalone) instead of localhost, and both networks use the
#     single standalone node's external gRPC (40401) and HTTP/WS (40403) ports;
#   - the F1r3drive process runs co-located inside the embers container
#     (docker/embers-entrypoint.sh in the embers repo), configured by the
#     F1R3DRIVE_* block below.
#
# Every key below is a published, test-only local-development key already
# committed in embers-local-stack/stack.sh and the genesis files. Do not reuse
# any of them outside a private development chain.

RUST_BACKTRACE=full
EMBERS__LOG_LEVEL=info,embers=info

# Browser-facing URL of a run inspector page (embers-frontend serves it).
EMBERS__PUBLIC_RUN_URL=http://localhost:8081/runs

EMBERS__AES_ENCRYPTION_KEY=48E37E0E448C482ADEAE83CD15FE91AA4E2459ED67D707BB40EF17BB18E60EE4

# Agent Teams continuation store: must sit inside the co-located F1r3drive
# FUSE mount, under the service wallet's unlocked directory.
EMBERS__CONTINUATION_STORE__MOUNT_PATH=/mnt/f1r3drive/1111jyBBTGUTqnvcd7ggu8YdaZjhi4yTkFksgnMAKWmZ1HoTzDzk2
EMBERS__CONTINUATION_STORE__ENCRYPTION_KEY=6CFB90BBF4AC42B1B252B9952A07FB9355C7DDF801956392752A4017282B73A8
EMBERS__CONTINUATION_STORE__CAPABILITY_KEY=1278718974113114843C9D71710CB0C4DFE7D23DC5F708FD2293AC0A74A8E104
EMBERS__CONTINUATION_STORE__MAX_OBJECT_BYTES=67108864
EMBERS__CONTINUATION_STORE__RECOVERY_POLL_MILLIS=1000

EMBERS__FINALIZATION__DEPLOY_TIMEOUT_MILLIS=120000

# Mainnet module: served by the one standalone node.
EMBERS__MAINNET__DEPLOY_SERVICE_URL=http://rnode.rust-standalone:40401
EMBERS__MAINNET__OBSERVER_URL=http://rnode.rust-standalone:40403
EMBERS__MAINNET__OBSERVER_WS_API_URL=ws://rnode.rust-standalone:40403
EMBERS__MAINNET__VALIDATOR_WS_API_URL=ws://rnode.rust-standalone:40403
EMBERS__MAINNET__SERVICE_KEY=232DADA5BBAFC0799D5F370DA04AF70CE438F69F954512B26D6FB5B560B81DFE
EMBERS__MAINNET__WALLETS_ENV_KEY=8BDC54B5551812C43428EB172A2079ABBEF13B5370BB7535F78807CDEBA3E7B3
EMBERS__MAINNET__AGENTS_ENV_KEY=69D4BC8ED86915383E68FAF1E4F9D8E22E02CDD3702730C61FE3B45FBBDF0097
EMBERS__MAINNET__AGENTS_TEAMS_ENV_KEY=85348C6D6AEF0B4761F8B8047111B3A2F7C9DF8CB24F91B66B77893DDE21DEE5
EMBERS__MAINNET__OSLFS_ENV_KEY=E6441631C4E164BF13A0532BF6775606965089CE3750E5ED39AAA9EC0DF81E67

# Testnet module: same standalone node serves both networks, so its genesis
# must fund both service wallets (see ../genesis/standalone-wallets.txt).
EMBERS__TESTNET__DEPLOY_SERVICE_URL=http://rnode.rust-standalone:40401
EMBERS__TESTNET__OBSERVER_URL=http://rnode.rust-standalone:40403
EMBERS__TESTNET__OBSERVER_WS_API_URL=ws://rnode.rust-standalone:40403
EMBERS__TESTNET__VALIDATOR_WS_API_URL=ws://rnode.rust-standalone:40403
EMBERS__TESTNET__SERVICE_KEY=732240A471E12931D858F147165BA1B52C011B92B9E8CD7959AADF06D7ACE622
EMBERS__TESTNET__ENV_KEY=D1BD29C232D11142E852EEE23482B239AF5494DFA10D64E82A72A8CDF82D5127

# Co-located F1r3drive (consumed by docker/embers-entrypoint.sh, not embers).
# Both gRPC channels target the standalone node's external gRPC port, exactly
# as the native stack does.
F1R3DRIVE_VALIDATOR_HOST=rnode.rust-standalone
F1R3DRIVE_VALIDATOR_PORT=40401
F1R3DRIVE_OBSERVER_HOST=rnode.rust-standalone
F1R3DRIVE_OBSERVER_PORT=40401
F1R3DRIVE_WALLET_ADDRESS=1111jyBBTGUTqnvcd7ggu8YdaZjhi4yTkFksgnMAKWmZ1HoTzDzk2
F1R3DRIVE_WALLET_KEY=232DADA5BBAFC0799D5F370DA04AF70CE438F69F954512B26D6FB5B560B81DFE
F1R3DRIVE_MANUAL_PROPOSE=true
NODE_HTTP_WAIT_URL=http://rnode.rust-standalone:40403/status
